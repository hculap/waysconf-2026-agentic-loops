---
/**
 * The TURBINE landing page.
 *
 * This file is deliberately thin. Every section owns its own <Section>, which
 * is what emits `data-section` and the matching `id`, so the canonical order in
 * docs/CANON.md §7 is expressed here as nothing more than the order of the
 * elements below — AC-06 reads it straight out of the DOM.
 *
 * Nav and Footer go into Base's named slots rather than the default one. Base
 * renders those slots outside <main>, which is the only reason the banner and
 * contentinfo landmarks are distinct from the main landmark (AC-09). Moving
 * either into the default slot nests it inside <main> and breaks that.
 *
 * The head strings are the four verbatim blocks of brief/CONTENT.md §1. They live
 * here rather than in Base because they are page copy, and CONTENT.md is the only
 * place that decides copy.
 */
import Base from '../layouts/Base.astro'
import Nav from '../sections/Nav.astro'
import Hero from '../sections/Hero.astro'
import Ticker from '../sections/Ticker.astro'
import Lineup from '../sections/Lineup.astro'
import Programme from '../sections/Programme.astro'
import Venue from '../sections/Venue.astro'
import Tickets from '../sections/Tickets.astro'
import Faq from '../sections/Faq.astro'
import Newsletter from '../sections/Newsletter.astro'
import Footer from '../sections/Footer.astro'

const title = 'TURBINE — 11–13 June 2027 — Hall E, Kraków'
const description =
  'Three nights of ambient, techno and modular sound in a power station that stopped making electricity in 1998. Kraków, 11–13 June 2027.'
const ogTitle = 'TURBINE — Three nights inside the machine'
const ogDescription =
  'Ambient, techno and modular sound in a hall built for power. Twelve artists, three stages, three nights. Kraków, 11–13 June 2027.'
const ogImageAlt =
  'The curved flank of a huge riveted turbine casing lit orange from one side, the rest of the frame falling away into darkness.'
---

<Base
  title={title}
  description={description}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogImageAlt={ogImageAlt}
>
  <Nav slot="header" />

  <Hero />
  <Ticker />
  <Lineup />
  <Programme />
  <Venue />
  <Tickets />
  <Faq />
  <Newsletter />

  <Footer slot="footer" />
</Base>
