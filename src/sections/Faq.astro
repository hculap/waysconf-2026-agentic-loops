---
/**
 * FAQ — CANON §7 section 9.
 *
 * Eight questions, in the CONTENT.md §10 order, rendered as the FaqRow list from
 * FIGMA-SPEC §4.8 and §5.8: 800 wide and centred at 1440, filling the container
 * below that, hairline above the first row and below every row, gap 0.
 *
 * The accordion is an enhancement and the answers are the content. The page ships
 * with all eight panels open and all eight triggers reporting `aria-expanded="true"`;
 * src/scripts/accordion.ts closes them on load. With scripting off the reader gets
 * eight questions and eight answers, which is exactly what CONTENT.md §10 asks for,
 * and there is no state in which a question exists with its answer out of reach.
 *
 * Each trigger is a real <button>, so Enter and Space both fire it, focus stays on
 * the control, and none of that is keyboard code this file has to write or AC-19 has
 * to take on trust. The h3 wraps the button rather than sitting inside it — a button
 * takes phrasing content only, so the other nesting is invalid HTML — and the button's
 * own text is therefore both the heading and the accessible name of the control.
 *
 * Gates this section answers directly:
 *
 *   AC-06  `data-section="faq"` and the matching id, both set by Section.
 *   AC-08  h2 from Section, then one h3 per question. Nothing deeper.
 *   AC-14  three ids per item — the item, its trigger, its panel — none repeated.
 *   AC-19  eight buttons carrying aria-expanded, and nothing else in the section
 *          carries that attribute, so AC-47 counts eight questions and not nine.
 *   AC-23  the trigger is the whole row, 56px minimum at 390 and 64 above it. A
 *          24×24 chevron would clear the touch minimum and still be a poor target.
 *   AC-48  every item keeps the id CONTENT.md §10 gives it, because the footer links
 *          to three of them: #faq-accessibility, #faq-bring and #faq-lockers.
 *
 * Three readings of an ambiguous brief, recorded rather than hidden:
 *
 * 1. CONTENT.md §10 sanctions native <details>/<summary> and allows a custom
 *    accordion that matches its behaviour. This page uses the custom one, because
 *    <summary> does not expose an author-written `aria-expanded` and the shared
 *    module already maintains it. Both satisfy AC-19; only one of them is the same
 *    control on every engine.
 * 2. FIGMA-SPEC §5.8 lists eight different questions. CONTENT.md wins on strings by
 *    its own first paragraph, and §14 says as much in the other direction, so the
 *    questions here are the CONTENT.md ones. The eyebrow "Before you come" is one of
 *    the five strings §14 hands to the design file, so it stays.
 * 3. FIGMA-SPEC §4.8 declares two states, collapsed and expanded, and no hover. A
 *    full-width row that never reacts to a pointer is worse than the file implies, so
 *    the question takes the same 150ms colour change the nav links already use. It is
 *    the smallest affordance that stays inside the token set.
 *
 * A footer link lands on a collapsed question, not an open one: CONTENT.md §10 fixes
 * the load state at closed and the reader opens it from there. Auto-opening the
 * targeted item is one `data-accordion-open` away if that reading is ever reversed.
 */
import Section from '../components/Section.astro'

interface Question {
  /** The id CONTENT.md §10 fixes. The trigger and panel ids are derived from it. */
  id: string
  question: string
  /** One paragraph, verbatim from CONTENT.md §10. */
  answer: string
  /** The one address CONTENT.md §10 requires to be a mailto link inside the answer. */
  mail?: string
}

/** CONTENT.md §10, items 1 to 8, in that order. */
const questions: Question[] = [
  {
    id: 'faq-times',
    question: 'What time does it start and finish?',
    answer:
      'Doors at 19:00 on Friday and Saturday, 17:30 on Sunday. The last set ends at 04:00 on Friday and Saturday and at 02:00 on Sunday, and the hall clears half an hour later. Full set times are in the programme above.',
  },
  {
    id: 'faq-age',
    question: 'Is there an age limit?',
    answer:
      'Yes. Eighteen and over, on every night and in the workshop. We check photo ID at the gate and we do not make exceptions.',
  },
  {
    id: 'faq-reentry',
    question: 'Can I leave and come back?',
    answer:
      'Yes, on the same night, with your wristband. The gate stops readmitting at 02:00 on Friday and Saturday and at 00:30 on Sunday. The yard between the gate and the hall is the smoking area, so you do not have to leave the site for that.',
  },
  {
    id: 'faq-accessibility',
    question: 'What is the site like if I have access needs?',
    answer:
      'Step-free from the gate to all three stages. A lift serves the Boiler Room and the Cooling Tower balcony. The Turbine Hall has a raised viewing platform with its own bar and toilet. Accessible toilets on every level. A quiet room next to the gate stays open all night with the sound at conversation level, and ear defenders are free at the info desk. There is haze on all three stages and strobe in the Turbine Hall after midnight. Companion tickets for personal assistants are free: write to access@turbine.fm.',
    mail: 'access@turbine.fm',
  },
  {
    id: 'faq-bring',
    question: 'What should I bring?',
    answer:
      'Photo ID, your ticket on a phone or on paper, and ear protection. Bring a layer as well: the hall is unheated and sits at about fourteen degrees at three in the morning, in June. Leave glass, professional cameras and anything larger than a small rucksack at home.',
  },
  {
    id: 'faq-cashless',
    question: 'Is the site cashless?',
    answer:
      'The bars and the merchandise stand take cards and phones only. If you would rather not use a card, the desk by the gate turns cash into a festival card with no fee, and refunds the balance in cash on the same night.',
  },
  {
    id: 'faq-weather',
    question: 'What happens if it rains?',
    answer:
      'Nothing changes. All three stages are under cover and so is the queue. The only open ground is the yard between the gate and the hall, and that is forty metres.',
  },
  {
    id: 'faq-lockers',
    question: 'Are there lockers?',
    answer:
      'Nine hundred of them by the gate, €5 a night, large enough for a coat and a rucksack. They open and close as often as you like on the same wristband. The staffed cloakroom next to them takes coats until thirty minutes after the last set.',
  },
]

interface LinkedAnswer {
  before: string
  mail: string
  href: string
  after: string
}

/**
 * The address is cut out of the finished sentence rather than the sentence being
 * stored in halves. AC-38 matches the rendered text of the whole paragraph against
 * CONTENT.md, so the answer has to survive intact with a link in the middle of it,
 * and the only place the address is written is the `mail` field.
 */
const withLink = (item: Question): LinkedAnswer | null => {
  if (!item.mail) return null

  const [before, after] = item.answer.split(item.mail)
  return { before, mail: item.mail, href: `mailto:${item.mail}`, after }
}

/**
 * Display/Card-Title from FIGMA-SPEC §3 — Space Grotesk 500 at 20, 130%, tracking
 * tight — plus the row geometry from §4.8: full width, centred, 24 padding Y and a
 * 64 floor, dropping to 16 and 56 at 390 (§7).
 */
const trigger =
  'group flex min-h-[56px] w-full items-center justify-between gap-4 py-4 text-left ' +
  'font-display text-xl font-medium leading-[1.3] tracking-display text-text-primary ' +
  'transition-[color] duration-150 hover:text-accent-coolant tablet:min-h-16 tablet:py-6'

/** Body/Base on bg.base. text.secondary measures 8.83:1 there, clear of AA with room. */
const answer = 'text-base leading-relaxed text-text-secondary'

/** accent.coolant is the link colour in the palette: 12.57:1 on bg.base. */
const link = 'text-accent-coolant underline underline-offset-2'
---

<Section
  name="faq"
  kicker="Before you come"
  heading="Questions"
  intro="Eight things people write to us about."
>
  {/* faq/list. 800 and centred at 1440, filling the container below it. The hairline
      above the first row plus one below each row gives the gap-0 rule stack in §5.8. */}
  <div data-accordion class="mx-auto w-full max-w-[800px] border-t border-border-subtle">
    {
      questions.map((item) => {
        const parts = withLink(item)

        return (
          <div data-accordion-item id={item.id} class="border-b border-border-subtle">
            <h3>
              {/* Ships expanded. accordion.ts closes it, so the answer is never
                  hidden by markup that arrived without its behaviour. */}
              <button
                data-accordion-trigger
                type="button"
                id={`${item.id}-trigger`}
                aria-controls={`${item.id}-panel`}
                aria-expanded="true"
                class={trigger}
              >
                <span>{item.question}</span>

                <svg
                  viewBox="0 0 24 24"
                  width="24"
                  height="24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  class="shrink-0 text-accent-coolant transition-transform duration-150 group-aria-expanded:rotate-180"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </button>
            </h3>

            <div
              id={`${item.id}-panel`}
              role="region"
              aria-labelledby={`${item.id}-trigger`}
              class="pb-6 tablet:pr-12"
            >
              {/* The fragment stays on one line. Astro keeps template whitespace, and a
                  newline either side of the anchor would put a space before the full
                  stop that closes the sentence. */}
              <p class={answer}>
                {parts === null ? (
                  item.answer
                ) : (
                  <Fragment>{parts.before}<a href={parts.href} class={link}>{parts.mail}</a>{parts.after}</Fragment>
                )}
              </p>
            </div>
          </div>
        )
      })
    }
  </div>
</Section>

<script>
  import '../scripts/accordion'
</script>
