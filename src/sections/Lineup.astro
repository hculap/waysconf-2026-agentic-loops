/**
 * CONTENT 6. The visible label is short because the tab row has to survive 342px;
 * the accessible name is the one that says which day, because "Fri" on its own says
 * too little. The status strings live here, on `data-tab-status`, so that tabs.ts
 * never becomes a second place the copy is written down.
 */
const tabs = [
  { value: 'all', label: 'All', name: 'All twelve artists', status: 'Showing all twelve artists.' },
  {
    value: 'fri',
    label: 'Fri',
    name: 'Friday 11 June',
    status: 'Showing four artists playing Friday 11 June.',
  },
  {
    value: 'sat',
    label: 'Sat',
    name: 'Saturday 12 June',
    status: 'Showing four artists playing Saturday 12 June.',
  },
  {
    value: 'sun',
    label: 'Sun',
    name: 'Sunday 13 June',
    status: 'Showing four artists playing Sunday 13 June.',
  },
]

/**
 * FIGMA-SPEC 4.5: the headliner name is 24, everything else 20, and at 390 all of
 * them drop to 16 because the card is 163px wide there and a 20px name breaks into
 * three lines. Every step is on the CANON 5 scale (AC-31).
 */
const nameSize = {
  Headliner: 'text-base tablet:text-2xl',
  Main: 'text-base tablet:text-xl',
  Support: 'text-base tablet:text-xl',
}

/** Headliners take the arc fill; bg.base ink on arc is 4.53:1, the only pairing
    that passes there. The rest take the neutral fill, which keeps light ink. */
const badgeTone = { Headliner: 'arc', Main: 'neutral', Support: 'neutral' } as const

/** FIGMA-SPEC 4.5 drops the genre to text.secondary on the support variant. */
const genreTone = { Headliner: 'coolant', Main: 'coolant', Support: 'neutral' } as const
---

<Section
  name="lineup"
  heading="Lineup"
  intro="Twelve artists over three nights. Four a night, one stage at a time. Nothing you want to hear runs against anything else you want to hear."
>
  <div data-tabs class="flex flex-col gap-12">
    <div class="flex flex-col gap-3">
      {/* Ships hidden. tabs.ts is the one thing that reveals it, so the control can
          never appear without the behaviour behind it. */}
      <div
        data-tabs-list
        role="tablist"
        aria-label="Filter the lineup by day"
        hidden
        class="flex w-fit max-w-full flex-wrap gap-2 rounded-pill bg-bg-surface p-1"
      >
        {
          tabs.map((tab) => (
            <button
              data-tab
              data-tab-value={tab.value}
              data-tab-status={tab.status}
              type="button"
              role="tab"
              id={`lineup-tab-${tab.value}`}
              aria-controls="lineup-panel"
              aria-selected={tab.value === 'all' ? 'true' : 'false'}
              aria-label={tab.name}
              class="inline-flex items-center justify-center rounded-pill px-6 py-2 font-body text-sm font-semibold leading-6 text-text-secondary aria-[selected=false]:hover:bg-bg-raised aria-[selected=false]:hover:text-text-primary aria-selected:bg-accent-coolant aria-selected:text-text-on-accent"
            >
              {tab.label}
            </button>
          ))
        }
      </div>

      {/* The live region is what tells a screen reader user that twelve cards just
          became four. It ships with the "all" string because that is the state the
          page loads in, with or without scripting. */}
      <p data-tabs-status aria-live="polite" class="text-sm leading-normal text-text-secondary">
        Showing all twelve artists.
      </p>
    </div>

    <div
      data-tabs-panel
      id="lineup-panel"
      role="tabpanel"
      aria-labelledby="lineup-tab-all"
      class="grid grid-cols-2 gap-4 tablet:grid-cols-3 tablet:gap-6 desktop:grid-cols-4"
    >
      {
        artists.map((artist) => (
          <article
            data-tab-item
            data-artist={artist.name}
            data-day={artist.day}
            data-stage={artist.stage}
            class="group flex flex-col gap-3 overflow-hidden rounded-md border border-border-subtle bg-bg-surface transition-colors duration-150 hover:border-border-strong"
          >
            <div class="relative">
              <img
                src={`/images/${artist.image}`}
                alt={artist.alt}
                width="512"
                height="512"
                loading="lazy"
                decoding="async"
                class="aspect-[4/5] w-full object-cover"
              />

              {/* The hover wash is text.primary at 10%, the one overlay the palette
                  allows. It ships at opacity 0 so the colour the page actually
                  paints at rest is still an on-palette one (AC-26). */}
              <div
                class="pointer-events-none absolute inset-0 bg-text-primary opacity-0 transition-opacity duration-150 group-hover:opacity-10"
                aria-hidden="true"
              ></div>

              <Tag tone={badgeTone[artist.billing]} variant="solid" class="absolute left-3 top-3">
                {artist.billing}
              </Tag>
            </div>

            <div class="flex flex-col gap-2 p-4">
              <h3
                class:list={[
                  'font-display font-medium leading-[1.3] tracking-display text-text-primary',
                  nameSize[artist.billing],
                ]}
              >
                {artist.name}
              </h3>

              {/* Day and stage stack at 390 and sit on one line from 768 up, so the
                  separator is decoration that only exists in the row layout. */}
              <p class="flex flex-col gap-2 text-sm leading-normal text-text-secondary tablet:flex-row">
                <span>{artist.dayLabel}</span>
                <span aria-hidden="true" class="hidden tablet:inline">
                  ·
                </span>
                <span>{artist.stage}</span>
              </p>

              <Tag tone={genreTone[artist.billing]}>{artist.genre}</Tag>

              <p class="text-sm leading-normal text-text-secondary">{artist.blurb}</p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</Section>

<script>
  import '../scripts/tabs'
</script>
