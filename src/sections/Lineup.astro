---
/**
 * Lineup — twelve artist cards behind a day filter.
 *
 * The filter is an enhancement, not the content. The page ships with the tab list
 * carrying `hidden`, all twelve cards rendered and the status line already reading
 * the "all" string from CONTENT 6; src/scripts/tabs.ts unhides the list and takes
 * over from there. With scripting off nothing is unreachable, which is the whole
 * requirement — a filter that hides eight artists before the reader has asked is a
 * worse page than no filter at all.
 *
 * One tabpanel, not four. Four panels would mean four copies of the twelve cards,
 * and duplicate `data-artist` values and duplicate ids fail AC-39 and AC-14. The
 * script repoints the panel's `aria-labelledby` at whichever tab is selected, so
 * the panel is always named by the filter that produced it (AC-18).
 *
 * Gates this section answers directly:
 *
 *   AC-06  `data-section="lineup"` and the matching id, both set by Section.
 *   AC-08  h2 from Section, then one h3 per card. Nothing deeper.
 *   AC-39  every card carries `data-artist`, `data-day` and `data-stage` from
 *          CANON 2, and repeats the name and the genre in its own text, because a
 *          fact that only exists in an attribute is not on the page.
 *   AC-22  each portrait takes the alt text from CONTENT 13 verbatim. None of
 *          these images is decorative; the hover wash is a div, not an <img>.
 *          No alt repeats the artist's name: the card h3 already carries it, and a
 *          screen reader would otherwise announce the same name twice (CONTENT 13).
 *
 * Two readings of an ambiguous brief, recorded rather than hidden:
 *
 * 1. CONTENT 6 says every card carries a billing badge and that the badges read
 *    "Headliner", "Main" and "Support". FIGMA-SPEC 4.5 shows the badge on the
 *    `headliner` variant only. CONTENT owns the copy, so all twelve cards get one,
 *    and the visual hierarchy FIGMA-SPEC asks for is carried by tone instead:
 *    accent.arc for a headliner, the neutral fill for the rest.
 * 2. FIGMA-SPEC 5.4 gives this section the eyebrow "Twelve artists" and an intro
 *    that CONTENT 6 has since replaced. The replacement intro opens with those same
 *    two words, so the eyebrow would now repeat the line directly beneath it, and
 *    CONTENT 14 is explicit that it holds every remaining user-facing string. No
 *    kicker, and the discrepancy is worth raising against the Figma file.
 */
import Section from '../components/Section.astro'
import Tag from '../components/Tag.astro'

interface Artist {
  /** CANON 2 spelling, exactly. It is both the `data-artist` value and the h3. */
  name: string
  billing: 'Headliner' | 'Main' | 'Support'
  /** Matches the tabs' `data-tab-value`; tabs.ts compares the two directly. */
  day: 'fri' | 'sat' | 'sun'
  /** The day as the reader sees it in the meta line (CONTENT 6). */
  dayLabel: string
  stage: string
  genre: string
  blurb: string
  image: string
  alt: string
}

/** CANON 2, rows 1 to 12, in that order. Copy from CONTENT 6 and CONTENT 13. */
const artists: Artist[] = [
