---
/**
 * Ticker — the marquee band between the hero and the lineup.
 *
 * Four decisions in here are worth the words, because each one is a gate or a
 * conflict between two source documents.
 *
 *   AC-21  The strip stops dead under prefers-reduced-motion. Not slower and not
 *          paused mid-drift: no animation at all, which is the `static` variant
 *          of the Ticker component set in FIGMA-SPEC 4.9. The gate reads computed
 *          `animation-name` on this section and on every descendant of it, so a
 *          shortened duration would not satisfy it either.
 *
 *   AC-38  The tags are typed in capitals rather than set in capitals. The content
 *          gate reads `textContent`, which `text-transform` never touches, and
 *          CONTENT.md 5 writes them in caps. Tag.astro's usual advice — type
 *          sentence case and let the component uppercase — is the right default
 *          everywhere a screen reader will read the result, and it does not apply
 *          here: the whole strip is `aria-hidden` and the visually hidden sentence
 *          beside it is what is actually announced.
 *
 *   AC-15  CANON 4 gives the marquee to accent.arc. CONTRAST.md measures arc at
 *          4.53:1 on bg.base and 3.80:1 on bg.raised, and Mono/Tag is 12px, so on
 *          bg.raised it is an axe violation and on bg.base it passes. FIGMA-SPEC
 *          4.9 fills the band with bg.raised; CANON 9 outranks the Figma file and
 *          CANON 4 fixes the ink, so the fill is the part that moves. The band is
 *          delimited by its two hairlines instead, which 4.9 asks for anyway.
 *          The separators take the same arc for the same reason: FIGMA-SPEC draws
 *          them as a 4x4 dot in border.strong, but CONTENT.md 5 specifies the
 *          character "·", and a character is text — border.strong measures 1.98:1
 *          and would fail where a drawn dot, being decoration, would not.
 *
 *   AC-09  The band renders as a <div>, not a <section>. Every <section> on the
 *          page has to carry an accessible name, and this one has nothing to name
 *          it with: CONTENT.md 15 gives it no heading and CONTENT.md 14 makes the
 *          strip aria-hidden with a sentence beside it as the spoken equivalent.
 *          Labelling it anyway would promote decoration to a landmark region that
 *          every screen-reader user then walks past. `data-section="ticker"` and
 *          the id are unaffected — AC-06 reads the attribute, not the tag.
 */
import Section from '../components/Section.astro'
import Tag from '../components/Tag.astro'

/**
 * CONTENT.md 5, in this order: the twelve genre tags from CANON 2 plus two
 * textures of the room. The capitals are the copy, not a style.
 */
const TAGS = [
  'INDUSTRIAL TECHNO',
  'DEEP AMBIENT',
  'DRONE',
  'CONCRETE AND STEEL',
  'MODULAR LIVE',
  'HARDWARE TECHNO',
  'FIELD RECORDING',
  'TAPE LOOPS',
  'DUB TECHNO',
  'SODIUM LIGHT',
  'NEOCLASSICAL ELECTRONIC',
  'PERCUSSIVE AMBIENT',
  'GENERATIVE',
  'GLASSY IDM',
]

/**
 * CONTENT.md 5 puts a separator between every pair of tags, the loop seam
 * included. Each track therefore ends with one, which is also what makes the
 * seam arithmetic work: see the trailing padding on the track below.
 */
const SEPARATOR = '·'

/** CONTENT.md 5. The accessible equivalent of the whole strip, verbatim. */
const SPOKEN_EQUIVALENT =
  'Genres across the three nights: industrial techno, deep ambient, drone, modular live, hardware techno, field recording, tape loops, dub techno, neoclassical electronic, percussive ambient, generative and glassy IDM. Between them, two words for the room: concrete and steel, sodium light.'

/**
 * Two identical tracks. One drifts out of the clip while the other drifts in, and
 * the animation resets the moment the second reaches the first one's origin, so
 * the loop has no visible restart. Both are inside the `aria-hidden` strip, so the
 * duplication costs a screen reader nothing.
 */
const COPIES = [0, 1]
---

<Section name="ticker" as="div" flush bleed class="border-y border-border-subtle">
  <p class="ticker__spoken">{SPOKEN_EQUIVALENT}</p>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__rail">
      {
        COPIES.map((copy) => (
          <ul
            class="ticker__track flex flex-none items-center gap-4 whitespace-nowrap pe-4 tablet:gap-6 tablet:pe-6"
            data-ticker-copy={copy}
          >
            {TAGS.map((tag) => (
              <Fragment>
                <Tag as="li" tone="arc">{tag}</Tag>
                <li class="font-mono text-xs font-bold text-accent-arc">{SEPARATOR}</li>
              </Fragment>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</Section>

<style>
  /* FIGMA-SPEC 5.3, 6 and 7: 56 at 1440, 48 at 768, 44 at 390. Fixed, because a
     band that grows with its content stops being a rule between two sections.
     None of the three is on the spacing scale and none of them needs to be —
     AC-32 governs margin, padding, gap and radius, not height. */
  .ticker {
    display: flex;
    align-items: center;
    height: 44px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .ticker {
      height: 48px;
    }
  }

  @media (min-width: 1440px) {
    .ticker {
      height: 56px;
    }
  }

  /* The rail is twice as wide as anything on screen and is a flex item, so it has
     to be told not to let the clip squeeze it back to the viewport. */
  .ticker__rail {
    display: flex;
    flex: none;
    width: max-content;
    animation: ticker-drift 60s linear infinite;
  }

  /* Half the rail is exactly one track plus one gap, because each track carries
     its gap as trailing padding rather than leaving it to the rail. The second
     copy therefore arrives precisely where the first one started. Distribute the
     gap any other way and the loop jumps by half of it on every cycle. */
  @keyframes ticker-drift {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  /* CONTENT.md 5: the tags stay still and the strip moves only if the reader
     scrolls it. The animation goes rather than slows — AC-21 measures the
     computed animation, not the intent — and the overflow becomes scrollable so
     the tags past the fold are still reachable without it. */
  @media (prefers-reduced-motion: reduce) {
    .ticker {
      overflow-x: auto;
    }

    .ticker__rail {
      animation: none;
    }
  }

  /* Tailwind's `sr-only` declares `margin: -1px`, which AC-32 reads as a 1px
     margin off the spacing scale. This is the same clipping trick without any box
     value to fall off it. */
  .ticker__spoken {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
