---
/**
 * Programme — three nights, three stages, twelve sets.
 *
 * The same twelve sets are rendered twice, and that is the design rather than a
 * duplication to tidy up later. A timetable is a two-dimensional relationship, time
 * against stage, and 342px of content width cannot hold four columns without either a
 * horizontal scroller or type nobody can read. So the table is the rendering above 768
 * and the stacked list is the rendering below it, both always in the DOM with only
 * `display` deciding which one is painted (FIGMA-SPEC §7: `TimetableRow` switches to
 * `Layout=stacked` at 390). brief/CONTENT.md §7 commissions copy for both, which is the
 * brief saying the same thing.
 *
 * Both carry `data-day` and `data-stage`, so the AC-47 contract resolves against
 * whichever rendering is on screen instead of against the one that happens to be a
 * table today.
 */
import Section from '../components/Section.astro'

/** CANON §2 stage order, which is also the column order CONTENT.md §7 fixes. */
const STAGES = ['Turbine Hall', 'Boiler Room', 'Cooling Tower'] as const

type Stage = (typeof STAGES)[number]

interface ProgrammeSet {
  /** A range, written with a space either side of the en dash, as CONTENT.md §7 has it. */
  time: string
  stage: Stage
  artist: string
}

interface Day {
  /** CANON §2 day value. The programme-cell contract in ACCEPTANCE.md reads this. */
  key: 'Fri' | 'Sat' | 'Sun'
  heading: string
  doors: string
  caption: string
  /** Saturday is the only night with something scheduled before doors. */
  daytime?: string[]
  /** One set per time row: CONTENT.md §7 runs one stage at a time. */
  sets: ProgrammeSet[]
}

const DAYS: Day[] = [
  {
    key: 'Fri',
    heading: 'Friday 12 June',
    doors: 'Doors 19:00 · Last set ends 04:00 · Hall clears 04:30',
    caption: 'Friday 12 June, set times by stage',
    sets: [
      { time: '19:30 – 21:00', stage: 'Cooling Tower', artist: 'Hiroko Vane' },
      { time: '21:15 – 22:45', stage: 'Boiler Room', artist: 'TAPE DECAY' },
      { time: '23:00 – 00:45', stage: 'Boiler Room', artist: 'Auric Drift' },
      { time: '01:00 – 04:00', stage: 'Turbine Hall', artist: 'KASIMIR VOLT' },
    ],
  },
  {
    key: 'Sat',
    heading: 'Saturday 13 June',
    doors: 'Doors 19:00 · Last set ends 04:00 · Hall clears 04:30',
    caption: 'Saturday 13 June, set times by stage',
    daytime: [
      '14:00 – 17:00 · Boiler Room · Modular synthesis workshop with Mara Teschke. Full Pass + Workshop only, 40 places.',
      'Workshop entry from 13:30 at the gate. The hall opens to everyone at 19:00.',
    ],
    sets: [
      { time: '19:30 – 21:00', stage: 'Cooling Tower', artist: 'Odalys Ferrer' },
      { time: '21:15 – 23:00', stage: 'Cooling Tower', artist: 'Cold Cathode' },
      { time: '23:15 – 01:00', stage: 'Boiler Room', artist: 'Mara Teschke' },
      { time: '01:15 – 04:00', stage: 'Turbine Hall', artist: 'Lena Orbis' },
    ],
  },
  {
    key: 'Sun',
    heading: 'Sunday 14 June',
    doors: 'Doors 17:30 · Last set ends 02:00 · Hall clears 02:30',
    caption: 'Sunday 14 June, set times by stage',
    sets: [
      { time: '18:00 – 19:30', stage: 'Cooling Tower', artist: 'Ilse Rüm' },
      { time: '19:45 – 21:15', stage: 'Boiler Room', artist: 'VITRINE' },
      { time: '21:30 – 23:15', stage: 'Boiler Room', artist: 'SUBSTATION 9' },
      { time: '23:30 – 02:00', stage: 'Turbine Hall', artist: 'NULLSET' },
    ],
  },
]

const intro =
  'One stage plays at a time. The night opens in the Cooling Tower, moves down to the Boiler Room and finishes on the main floor. Changeovers take fifteen minutes and the walk between stages takes about four.'

const note =
  'All times are Central European Summer Time. Set times can move. Anything that changes is posted at the gate and here.'

/**
 * Visually hidden, still announced. Deliberately not Tailwind's `sr-only`: that utility
 * declares `margin: -1px`, 1px is not a step on the spacing scale, and AC-32 reports an
 * off-scale margin on every element carrying it. `clip-path` does the same job with no
 * box value to declare.
 */
const visuallyHidden = 'absolute h-px w-px overflow-hidden whitespace-nowrap [clip-path:inset(50%)]'

/** Label/Eyebrow on the bg.raised header fill — 7.40:1, see CONTRAST.md §3. */
const headCell = 'bg-bg-raised p-4 text-left text-xs font-semibold uppercase tracking-[0.06em] text-text-secondary'

/** Body/Base-Medium, and the hairline that separates one set from the next. */
const bodyCell = 'border-b border-border-subtle p-4 text-left text-base font-medium text-text-primary'
---

<Section name="programme" heading="Programme" intro={intro}>
  {
    DAYS.map((day) => (
      <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-2">
          <h3 class="font-display text-2xl font-medium tracking-display desktop:text-3xl">{day.heading}</h3>
          <p class="font-mono text-sm leading-normal text-text-secondary">{day.doors}</p>
        </div>

        {day.daytime && (
          <div class="flex flex-col gap-2 rounded-md border border-border-subtle bg-bg-surface p-4">
            {day.daytime.map((line) => (
              <p class="text-sm leading-relaxed text-text-secondary">{line}</p>
            ))}
          </div>
        )}

        {/* Above 768. `border-separate` because preflight collapses table borders, and a
            collapsed border cannot carry the 4px radius on the header fill. */}
        <table class="hidden w-full border-separate border-spacing-0 tablet:table">
          <caption class={visuallyHidden}>{day.caption}</caption>
          <thead>
            <tr>
              <th scope="col" class={`${headCell} rounded-tl-sm`}>
                Time
              </th>
              {STAGES.map((stage, index) => (
                <th scope="col" class:list={[headCell, index === STAGES.length - 1 && 'rounded-tr-sm']}>
                  {stage}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {day.sets.map((set) => (
              <tr data-day={day.key}>
                <th
                  scope="row"
                  class="border-b border-border-subtle p-4 text-left font-mono text-sm font-normal whitespace-nowrap text-accent-coolant"
                >
                  {set.time}
                </th>
                {STAGES.map((stage) => (
                  <td data-stage={stage} class={bodyCell}>
                    {stage === set.stage ? (
                      set.artist
                    ) : (
                      <Fragment>
                        {/* CONTENT.md §14: the dash is decoration, "No set" is the reading. */}
                        <span aria-hidden="true" class="font-normal text-text-secondary">
                          —
                        </span>
                        <span class={visuallyHidden}>No set</span>
                      </Fragment>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>

        {/* Below 768. The stage name moves inside the row and the empty stages go away
            entirely, because a column of em dashes is a column nobody needs on a phone. */}
        <ul class="flex flex-col tablet:hidden">
          {day.sets.map((set) => (
            <li
              data-day={day.key}
              data-stage={set.stage}
              class="flex flex-wrap items-baseline border-b border-border-subtle py-4"
            >
              <span class="font-mono text-sm text-accent-coolant">{set.time}</span>
              {/* The separators are real characters, not a `gap`: CONTENT.md §7 writes the
                  stacked row as one string and the content gate reads text, not layout.
                  Non-breaking spaces so nothing collapses them out of the flex row, and
                  `&nbsp;` rather than a numeric entity, which AC-27 reads as a hex colour. */}
              <span aria-hidden="true" class="text-text-secondary">&nbsp;·&nbsp;</span>
              <span class="text-sm text-text-secondary">{set.stage}</span>
              <span aria-hidden="true" class="text-text-secondary">&nbsp;·&nbsp;</span>
              <span class="text-base font-medium text-text-primary">{set.artist}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <p class="max-w-[720px] text-sm leading-relaxed text-text-secondary">{note}</p>
</Section>
