---
/**
 * Nav — the sticky bar at the top of the page.
 *
 * Wordmark left, four links, ticket CTA right (CONTENT 3). Below 768 the links and
 * the CTA collapse behind a hamburger, which is the one responsive instruction
 * CANON 7 gives this bar.
 *
 * Four things here are gates rather than taste:
 *
 *   AC-09  the banner is this <header> and the navigation landmark is the <nav>
 *          inside it, named "Primary". One of each, nested, and no other element
 *          in this file claims a role.
 *   AC-13  four links plus one CTA, every fragment resolving to a real id. The
 *          wordmark is counted apart from those five, which is why #top has to
 *          exist somewhere: CONTENT 16 lists it as a document anchor rather than
 *          a section, so no section owns it and it would otherwise go undeclared.
 *          It sits on the <nav>, the first element of the document.
 *   AC-23  every control clears 24x24 at 390. The links reach 48 through 12px of
 *          padding on a 24px line box, exactly as FIGMA-SPEC 4.3 asks; the
 *          wordmark and the hamburger are given the same 48px box, so the height
 *          of the bar is one number instead of three — 64 at 390 and 768, 72 at
 *          1440, per FIGMA-SPEC 5.1 and 6.
 *   AC-33  horizontal space is the container's, never this file's. FIGMA-SPEC 6
 *          asks for a 32px gutter at 768 where .container-turbine gives 48; the
 *          container is the single source CANON 6 fixes and AC-33 measures, so
 *          the container wins and the bar does not set its own inline padding.
 *
 * The drawer stays in the flow rather than floating over the page. With scripting
 * off the menu ships visible, and an in-flow menu then reads as a taller header;
 * a sheet pinned over the hero with no script to dismiss it would not.
 * src/scripts/nav.ts owns both the toggle's and the menu's visibility across the
 * breakpoint, so nothing here hides either: `tablet:contents` changes only how the
 * menu's children are laid out once they are shown — at 768 and up it dissolves
 * the wrapper so the wordmark, the links and the CTA are the three items the
 * space-between row expects — and the `hidden` attribute beats it either way,
 * because Tailwind's preflight declares that rule important.
 *
 * No active-link state is wired. FIGMA-SPEC 5.1 composes every frame with
 * `Active=none`, and scroll spying is behaviour the brief does not ask for.
 */
import Button from '../components/Button.astro'
import Section from '../components/Section.astro'

/** CONTENT 3, in order. Every target is a canonical section id, which is what AC-13 resolves. */
const links = [
  { label: 'Lineup', href: '#lineup' },
  { label: 'Programme', href: '#programme' },
  { label: 'Venue', href: '#venue' },
  { label: 'Questions', href: '#faq' },
]

/**
 * Body/Base-Medium at 390 and 1440, Body/Small-Medium at 768 (FIGMA-SPEC 6). The
 * line box is pinned to 24 rather than the text style's 162%, because 4.3 fixes
 * the hit target at 48 and 12 + 24 + 12 is the only arithmetic that reaches it.
 *
 * The hover fade names `color` rather than using `transition-colors`, which also
 * transitions `outline-color`. That would fade the focus ring in from the link's
 * own text colour, and a focus indicator that arrives over 150ms is a focus
 * indicator that is briefly the wrong colour when AC-17 measures it.
 */
const linkClass =
  'block whitespace-nowrap py-3 font-body text-base leading-6 font-medium text-text-secondary ' +
  'no-underline transition-[color] duration-150 hover:text-text-primary tablet:text-sm desktop:text-base'
---

<Section
  name="nav"
  as="header"
  tone="surface"
  flush
  class="sticky top-0 z-50 border-b border-border-subtle"
>
  <nav
    id="top"
    data-nav
    aria-label="Primary"
    class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-2 desktop:py-3"
  >
    {/* CONTENT 3: live text, never an image. The visible word is inside the
        accessible name, so speech input can still say "TURBINE" (WCAG 2.5.3). */}
    <a
      href="#top"
      aria-label="TURBINE — back to top"
      class="inline-flex h-12 shrink-0 items-center font-display text-xl leading-none font-bold tracking-wordmark text-text-primary no-underline"
      >TURBINE</a
    >

    {/* Ships hidden and stays hidden at 768 and up; src/scripts/nav.ts is the only
        thing that reveals it. The two labels come from CONTENT 14 and live here
        rather than in the script, so the copy stays in one place. */}
    <button
      data-nav-toggle
      type="button"
      hidden
      aria-controls="nav-menu"
      aria-expanded="false"
      aria-label="Open menu"
      data-label-open="Open menu"
      data-label-close="Close menu"
      class="inline-flex size-12 shrink-0 items-center justify-center rounded-pill text-accent-coolant transition-[background-color] duration-150 hover:bg-bg-raised"
    >
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>

    <div id="nav-menu" data-nav-menu class="flex w-full flex-col gap-2 tablet:contents">
      <ul class="flex flex-col tablet:flex-row tablet:items-center tablet:gap-6 desktop:gap-8">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>{link.label}</a>
            </li>
          ))
        }
      </ul>

      <Button href="#tickets" variant="primary" size="sm">Tickets</Button>
    </div>
  </nav>
</Section>

<script>
  import '../scripts/nav'
</script>
