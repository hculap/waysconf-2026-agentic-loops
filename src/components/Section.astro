---
/**
 * Section — the shell every canonical section is built inside.
 *
 * It exists to make three things impossible to get wrong across eleven separate
 * files:
 *
 *   AC-06  the section carries `data-section` and `id` set to the same canonical
 *          name, spelled once here instead of eleven times.
 *   AC-33  horizontal space comes from `.container-turbine` — max-width 1200,
 *          gutter 24 at 390 and 48 at 1440 — and from nothing else.
 *   AC-09  every <section> on the page carries an accessible name. `heading` names
 *          it from the heading this component renders, `labelledBy` from one the
 *          section renders itself — the hero's h1 — and `label` from a string where
 *          there is no heading at all. A section that should not be a landmark
 *          passes `as="div"` instead of shipping an anonymous region: that is the
 *          ticker, whose strip is aria-hidden decoration with a text equivalent
 *          beside it rather than a destination anyone navigates to.
 *
 * Vertical rhythm is the responsive/section-pad-y variable from FIGMA-SPEC 2.5:
 * 64 at 390, 96 at 768, 128 at 1440. It is set here and nowhere else, because two
 * sources of vertical rhythm is one too many and the diff finds the difference.
 */
import SectionHeading from './SectionHeading.astro'

interface Props {
  /**
   * The canonical name from CANON 7: skip-link, nav, hero, ticker, lineup,
   * programme, venue, tickets, faq, newsletter, footer. Becomes both the
   * `data-section` value AC-06 reads and the `id` the nav anchors point at.
   */
  name: string
  /** Renders a SectionHeading block above the slot. */
  kicker?: string
  heading?: string
  /** CONTENT 15 fixes every section heading at h2; subsections pass 3. */
  headingLevel?: 2 | 3
  intro?: string
  /**
   * Id of a heading the section renders for itself, when that heading cannot come
   * from `heading`. The hero is the only caller: its h1 belongs to the hero, not to
   * SectionHeading, and AC-07 allows exactly one of them on the page.
   */
  labelledBy?: string
  /** Accessible name for a section that has no visible heading. */
  label?: string
  /** bg.surface lifts a section off the page; newsletter is the one that does. */
  tone?: 'base' | 'surface'
  /** Full-bleed content: the ticker marquee and the hero image ignore the gutter. */
  bleed?: boolean
  /** Drop the vertical rhythm. The nav and the ticker set their own height. */
  flush?: boolean
  /** Element to render. The footer and the header are sections too. */
  as?: 'section' | 'header' | 'footer' | 'nav' | 'div'
  class?: string
  containerClass?: string
}

/**
 * The `: Props` annotation is load-bearing and not decoration. Astro reserves the
 * prop name `as` for its polymorphic-component helper, and a Props interface that
 * declares one stops being inferred onto Astro.props: every destructured value
 * silently becomes `any` and `astro check` then fails on the first index into a
 * lookup table (AC-02). Annotating the destructure puts the type back.
 */
const {
  name,
  kicker,
  heading,
  headingLevel = 2,
  intro,
  labelledBy,
  label,
  tone = 'base',
  bleed = false,
  flush = false,
  as: Wrapper = 'section',
  class: className,
  containerClass,
}: Props = Astro.props

const headingId = heading ? `${name}-heading` : undefined
const nameFrom = headingId ?? labelledBy

const tones = {
  base: 'bg-bg-base',
  surface: 'bg-bg-surface',
}
---

<Wrapper
  id={name}
  data-section={name}
  class:list={[
    tones[tone],
    !flush && 'py-16 tablet:py-24 desktop:py-32',
    className,
  ]}
  aria-labelledby={nameFrom}
  aria-label={!nameFrom && label ? label : undefined}
>
  {
    bleed ? (
      <slot />
    ) : (
      <div class:list={['container-turbine flex flex-col gap-12', containerClass]}>
        {heading && (
          <SectionHeading kicker={kicker} heading={heading} level={headingLevel} id={headingId} intro={intro} />
        )}
        <slot />
      </div>
    )
  }
</Wrapper>
