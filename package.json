{
  "name": "turbine-festival",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "TURBINE festival landing page — workshop project for the WaysConf 2026 masterclass 'Build an AI that checks and fixes its own work'",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/copy-assets.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node checks/run.mjs",
    "check:build": "node checks/gates/build.mjs",
    "check:structure": "playwright test checks/specs/structure.spec.ts",
    "check:tokens": "playwright test checks/specs/tokens.spec.ts",
    "check:links": "playwright test checks/specs/links.spec.ts",
    "check:content": "playwright test checks/specs/content.spec.ts",
    "check:a11y": "playwright test checks/specs/a11y.spec.ts",
    "check:visual": "playwright test checks/specs/visual.spec.ts",
    "check:perf": "node checks/gates/lighthouse.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:guideline": "node checks/guideline.mjs",
    "check:guideline:behaviour": "node checks/guideline-behaviour.mjs",
    "check:deck": "node checks/deck.mjs",
    "gen:images": "node scripts/generate-images.mjs --all",
    "baseline": "node checks/baseline.mjs",
    "deploy": "npx netlify deploy --prod --dir=dist",
    "check:imagecontrast": "node checks/gates/image-contrast.mjs"
  },
  "dependencies": {
    "astro": "^5.14.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.14",
    "lighthouse": "^12.8.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
