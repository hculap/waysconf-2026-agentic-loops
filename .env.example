# You only need this if you want to regenerate the image pack yourself.
# Every image is already committed under design/assets/, so the workshop works without it.
GEMINI_API_KEY=

# Deploying. `npm run deploy` calls the Netlify CLI through npx, so there is nothing
# to install. It does need an account, one of two ways:
#
#   npx netlify login        opens a browser, authorises once, remembers you
#   NETLIFY_AUTH_TOKEN=...   a personal access token from
#                            https://app.netlify.com/user/applications
#
# NETLIFY_SITE_ID is optional. Leave it empty and the CLI asks which site to create
# or link on the first deploy; fill it in to deploy straight to an existing site.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
